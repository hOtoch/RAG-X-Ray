# Copie para .env e preencha. Nunca versione o .env.

# --- LLM: provedor e modelos por nível (small / medium / large) ---
# Provedores aceitos: openai, anthropic. Os preços ficam em configs/prices.yaml.
LLM_PROVIDER=openai
LLM_MODEL_SMALL=gpt-4o-mini
LLM_MODEL_MEDIUM=gpt-4.1-mini
LLM_MODEL_LARGE=gpt-4.1
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Embeddings e reranker (cross-encoder local, ver ADR-0006) ---
RERANKER_MODEL=jinaai/jina-reranker-v1-turbo-en
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Postgres + pgvector (docker compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ragxray
POSTGRES_USER=ragxray
POSTGRES_PASSWORD=ragxray

# --- Redis (cache exato e semântico) ---
REDIS_URL=redis://localhost:6379/0

# --- Langfuse (tracing, sobe no docker compose em http://localhost:3000) ---
# As chaves abaixo são as que o compose cria na primeira subida; servem só para uso local.
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-ragxray-local
LANGFUSE_SECRET_KEY=sk-lf-ragxray-local

# --- Retrieval e orçamento ---
RETRIEVAL_TOP_K=5
MAX_RETRIES=2
REQUEST_BUDGET_USD=0.05
