# Copie para .env e preencha. Nunca versione o .env.
# Os campos são preenchidos conforme as issues de cada fase.

# --- LLM: provedor e modelos por nível (small / medium / large) ---
# LLM_PROVIDER=
# LLM_MODEL_SMALL=
# LLM_MODEL_MEDIUM=
# LLM_MODEL_LARGE=
# ANTHROPIC_API_KEY=

# --- Embeddings e reranker ---
# EMBEDDING_MODEL=
# RERANKER_MODEL=

# --- Postgres + pgvector ---
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# --- Redis (cache exato e semântico) ---
# REDIS_URL=

# --- Langfuse (tracing) ---
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- Limiares e orçamento ---
# RETRIEVAL_TOP_K=
# RERANK_TOP_K=
# SEMANTIC_CACHE_THRESHOLD=
# MAX_RETRIES=
# REQUEST_BUDGET_USD=
# DAILY_BUDGET_USD=
